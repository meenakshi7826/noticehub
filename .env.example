PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Link to the deployed frontend home page (include the repository path for GitHub Pages).
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed browser origins, e.g. https://yourname.github.io
FRONTEND_ORIGINS=
# Admin mailbox used for password recovery.
ADMIN_EMAIL=
# SMTP credentials for the mailbox or transactional email service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional sender address; defaults to SMTP_USER.
SMTP_FROM=
# Generate a bcrypt hash with: npm run hash-password
ADMIN_PASSWORD_HASH=
